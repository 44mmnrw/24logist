APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_FOLDER_ID=
SEO_TARGET_HOST=24logist.ru
SEO_DEFAULT_REGION_ID=225
SEO_DEFAULT_DEVICE=DEVICE_ALL
SEO_POSITION_DEPTH=100
APP_TIMEZONE=Europe/Moscow
# Production: https://24logist.ru (без www — основное зеркало для SEO и cookie)

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=en_US

IMAGE_OPTIMIZER_ENABLED=true
IMAGE_OPTIMIZER_NODE_BINARY=node
IMAGE_OPTIMIZER_TIMEOUT=120
IMAGE_OPTIMIZER_WEBP_QUALITY=82
IMAGE_OPTIMIZER_AVIF_QUALITY=62

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
FILESYSTEM_PUBLIC_URL=/storage
# Temp uploads on public disk → preview via /storage/livewire-tmp/ (needed for Filament repeater).
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

PUBLIC_PAGE_CACHE_ENABLED=true
PUBLIC_PAGE_CACHE_STORE=
PUBLIC_PAGE_CACHE_LANDING_TTL=300
PUBLIC_PAGE_CACHE_BROWSER_TTL=60
PUBLIC_PAGE_CACHE_SHARED_TTL=300
PUBLIC_PAGE_CACHE_STALE_WHILE_REVALIDATE=60
PUBLIC_PAGE_CACHE_STALE_IF_ERROR=86400

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@24logist.ru"
MAIL_FROM_NAME="${APP_NAME}"
# Production (пример): MAIL_MAILER=smtp, MAIL_HOST=smtp.yandex.ru, MAIL_PORT=465, MAIL_SCHEME=smtps

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
